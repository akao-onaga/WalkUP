// このファイルを Secrets.xcconfig にコピーし、実際のキーを記入する。
// Secrets.xcconfig は .gitignore 済みなのでコミットされない。
//
//   cp Secrets.xcconfig.example Secrets.xcconfig
//
// キーは RevenueCat ダッシュボード → Project settings → API keys の
// 「Public app-specific API key」(appl_ で始まる) を使う。
// Secret key ではないので端末に埋め込んで問題ないが、リポジトリには入れない。

REVENUECAT_API_KEY = appl_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
